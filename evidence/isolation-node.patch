+async fn cancel_replication_jobs(jobs: &mut mpsc::Receiver<Replication>, cause: &str) {
+    jobs.close();
+    while let Some(job) = jobs.recv().await {
+        let _ = job.reply.send(Err(anyhow::anyhow!(
+            "replication cancelled for shard {} sequence {}: {cause}",
+            job.batch.shard,
+            job.batch.sequence
+        )));
+    }
+}
